{
  "name": "gen-ui-audit",
  "version": "1.1.0",
  "description": "Portable UI validation framework combining Playwright automation with embedded Yumlog capture",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "install:browsers": "playwright install"
  },
  "keywords": [
    "screen-capture",
    "recording",
    "ffmpeg",
    "powershell",
    "automation",
    "ui-audit",
    "visual-regression"
  ],
  "author": "Darbot Labs",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
